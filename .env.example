# ==============================================================================
# KIVO MATIQUE - Configuration & Variables d'Environnement Vercel
# Ne JAMAIS commiter de vraies clés dans Git. Renseignez ces variables sur Vercel.
# ==============================================================================

# Supabase
SUPABASE_URL=https://fzdtdfymvhydtoyqpdxd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mode Sandbox Paiements (true en dev/test, false en production)
KIVO_PAYMENT_SANDBOX=true

# Stripe (Cartes Bancaires Visa / Mastercard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# MTN Mobile Money (Collection API - Afrique Centrale & Ouest)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CURRENCY=XAF

# Airtel Money (Collection API - Congo Brazzaville, etc.)
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_ENV=sandbox
AIRTEL_MONEY_COUNTRY=CG
AIRTEL_MONEY_CURRENCY=XAF

# CinetPay (Agrégateur Mobile Money Wave, Orange, MTN, Moov - Sénégal, CI, Cameroun, etc.)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Clé secrète pour sécuriser les appels Vercel Cron (Optionnel)
CRON_SECRET=

